{
  "name": "tableside",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:disposable": "sh -c 'set -a; . ./.env.e2e-disposable.local; set +a; next dev --port 3099'",
    "build": "next build && npm run sourcemaps",
    "sourcemaps": "tsx scripts/upload-sourcemaps.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:disposable": "playwright test --config=playwright.e2e-disposable.config.ts",
    "db:seed:users": "tsx scripts/seed-dev-users.ts",
    "billing:setup-prices": "tsx --env-file=.env.local scripts/setup-stripe-prices.ts",
    "billing:preflight": "tsx --env-file=.env.local scripts/check-stripe-mode.ts",
    "db:check-grants": "tsx --env-file=.env.local scripts/check-function-grants.ts",
    "db:backup": "tsx --env-file=.env.local scripts/backup-database.ts",
    "db:verify-backup": "tsx scripts/verify-backup.ts",
    "storage:cleanup": "tsx scripts/storage-cleanup.ts",
    "eval:waiter": "sh evals/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@base-ui/react": "^1.7.0",
    "@capacitor-community/stripe-terminal": "8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@sentry/browser": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
