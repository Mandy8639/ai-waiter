# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- PUBLIC (safe to expose in the browser bundle) ------------------------
# Read from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- SERVER ONLY (never reference with a NEXT_PUBLIC_ prefix) -------------
# The "service_role" / secret key. Bypasses Row Level Security. Server code
# only — see src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=your-secret-key

# --- PAYMENTS (server only) ------------------------------------------------
# Stripe, used for Connect onboarding and (from phase 2) card payments.
# Optional: with these unset the Payments dashboard says so and every other
# part of the app — orders, kitchen display, reservations — works exactly as
# it does today. Test-mode keys are enough to exercise the whole flow.
# STRIPE_SECRET_KEY=sk_test_...
#
# The signing secret for the webhook at /api/webhooks/stripe. This is the
# ONLY authentication that endpoint has, since Stripe calls it with no user
# session — see docs/security.md#payments.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# The signing secret for /api/webhooks/stripe/platform, which receives the
# PLATFORM account's own events (subscriptions). Deliberately a second
# secret and a second endpoint: the one above authenticates events about
# restaurants' charges, this one about the platform's revenue, and one
# secret verifying both would mean a leak of either compromises both.
# STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_...

# --- ERROR MONITORING (server only) ----------------------------------------
# Sentry DSN. Optional: with it unset nothing is sent anywhere and failures
# are still written to stdout as structured JSON, which is what local
# development and CI want — see src/lib/observability/report.ts.
#
# Deliberately @sentry/node rather than @sentry/nextjs: the latter hooks the
# build and is version-gated against standard Next, and this project runs a
# non-standard 16.3.2 fork (see AGENTS.md).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# The same DSN again, exposed to the browser for client-side errors (a
# React crash in a diner's browser, which the server DSN above never sees).
# A DSN is designed to ship in a browser bundle: it identifies a project,
# it does not authorise reading one — unlike SENTRY_AUTH_TOKEN below.
#
# A diner's URL carries a table token, so events are scrubbed before they
# leave — see src/lib/observability/scrub-url.ts.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Source map upload, so a production stack trace reads as your code rather
# than `_08the3w._.js, line 2, in a`. BUILD-TIME ONLY — these belong in
# Vercel's environment, not in a running server, and the token is a real
# credential unlike the DSN.
#
# Without them `npm run build` skips the upload and says why; it never
# fails. Only server maps are uploaded (browser maps are off), so no source
# is exposed publicly — see scripts/upload-sourcemaps.ts.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=ai-waiter
#
# Set to 1 to make a failed upload fail the build. Off by default: a Sentry
# outage should not block a deploy.
# SENTRY_SOURCEMAPS_STRICT=1

# Which AI backend serves the waiter — "anthropic" (production default) or
# "openrouter" (a cost-free option for local development). Neither
# provider ever requires the other provider's key below — see
# src/lib/ai/providers/ and docs/ai.md#provider-and-configuration.
# AI_PROVIDER=anthropic

# The AI waiter's model provider key when AI_PROVIDER=anthropic (the
# default) — server code only, see src/lib/ai/providers/anthropic.ts.
# Optional: if unset, the AI waiter is simply not offered and every other
# part of the app (menu, cart, checkout, order tracking, the kitchen
# display) works exactly as it does today — see docs/ai.md#ai-failure-fallback.
ANTHROPIC_API_KEY=

# The AI waiter's model provider key when AI_PROVIDER=openrouter — server
# code only, see src/lib/ai/providers/openrouter.ts. Get one free at
# https://openrouter.ai/keys. Defaults to a free, tool-calling-capable
# model (dots-studio/dots-3-note-preview:free) — no AI_MODEL needed to try
# it, and the next model in the list is tried automatically if that one is
# rate-limited or down (see docs/ai.md#model-fallback).
OPENROUTER_API_KEY=

# AI dish images (owner presses "Generate"; each image is approved before
# diners see it). Off unless MENU_IMAGE_MODEL is set. Paid, per image:
# openai/gpt-image-2.5-flare at low quality was about $0.0065 (2026-10-19).
# MENU_IMAGE_QUALITY (low|medium|high) applies to openai/ models, which
# default to low; other models get it only when set.
# MENU_IMAGE_MODEL=openai/gpt-image-2.5-flare
# MENU_IMAGE_QUALITY=low

# --- AI waiter tuning (all optional — see src/lib/ai/config.ts for defaults) ---
# AI_MODEL accepts one model, or a comma-separated preference list tried in
# order (OpenRouter only — Anthropic uses the first entry). A single value
# behaves exactly as before.
# AI_MODEL=claude-opus-5
# AI_MODEL=dots-studio/dots-3-note-preview:free,another/free-model:free
# The AI drafts' own list (nutrition estimates, translations). Free models
# only: anything without ":free" is ignored. Unset, drafts use the free
# models in AI_MODEL, then the vetted suggestion models.
# AI_DRAFT_MODEL=dots-studio/dots-3-note-preview:free
# Every model list above can also be set on /admin, which wins over these
# variables (docs/admin.md).
# AI_EFFORT=low
# AI_MAX_OUTPUT_TOKENS=1024
# AI_REQUEST_TIMEOUT_MS=20000
# AI_MAX_PROVIDER_RETRIES=2
# AI_MAX_TOOL_CALLS_PER_TURN=6
# AI_MAX_HISTORY_MESSAGES=20
# The staff assistant's reader (src/lib/staff-assistant/interpret.ts): one
# short message in, one JSON command out. Comma-separated preference list;
# defaults to the menu suggester's vetted list. OpenRouter only.
# STAFF_ASSISTANT_MODEL=
# AI_MAX_INPUT_LENGTH=2000
# AI_RATE_LIMIT_MAX_MESSAGES=20
# AI_RATE_LIMIT_WINDOW_MINUTES=10

# --- The Chef character (optional) ---
# Which restaurants show the AI waiter as the Chef: comma-separated
# restaurant slugs, or * for all. Unset means nobody, so a deploy without
# it changes nothing for diners. A server setting, not a restaurant one —
# rolled out to one restaurant first (src/lib/chef/feature.ts).
# CHEF_RESTAURANTS=my-restaurant

# --- Kitchen push alerts (optional — phase F) ---
# Without these, push is off: the kitchen page shows no "Turn on alerts"
# control and nothing tries to send. Generate a pair once, for free, with:
#   npx web-push generate-vapid-keys
# Use a DIFFERENT pair per environment. Changing a pair later turns off
# alerts on every device that subscribed with the old one.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://tableside.menu

# --- iOS app kitchen alerts (optional) ---
# Apple Push Notification service, for the Tableside iOS app (ios/). From
# the Apple Developer account: Certificates, Identifiers & Profiles → Keys →
# create a key with "Apple Push Notifications service (APNs)", download the
# .p8 once. With any of these unset, iOS alerts are off; web push and
# everything else is unaffected. See src/lib/push/apns-core.ts.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# The .p8 file's contents; on one line, replace newlines with \n.
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_BUNDLE_ID=menu.tableside.app

# The Android app's kitchen alerts, through Firebase Cloud Messaging: a
# Firebase service account (Project settings → Service accounts →
# Generate new private key). The private key on one line, with "\n" for
# its line breaks. Unset means the Android app hides "Turn on alerts".
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# --- Owner emails (optional — phase F) ---
# Without RESEND_API_KEY no email is sent and nothing fails. The key needs
# "Sending access" only, restricted to the mail.tableside.menu domain.
# RESEND_API_KEY=
# EMAIL_FROM=Tableside <hello@mail.tableside.menu>
# Where links in emails point (default https://tableside.menu).
# APP_URL=https://tableside.menu
# Vercel Cron sends this as "Authorization: Bearer ..." to
# /api/cron/daily-summary. Unset means the route refuses every call.
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# Orders keep ringing until accepted: a Supabase pg_cron job calls
# /api/cron/order-ring with "Authorization: Bearer ..." every 30 seconds
# while an order waits. Put the same value in Supabase Vault as
# 'order_ring_secret' (docs/security.md, "Order ring"). Unset means the
# route refuses every call, and orders ring once.
# Generate with: openssl rand -hex 32
# ORDER_RING_SECRET=

# --- Admin page (docs/admin.md) ---
# Comma-separated emails that may open /admin. Unset or empty means nobody.
# The account also needs two-step verification on.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Admin Phase 8 (docs/admin.md): plan price changes on /admin create Stripe
# prices, so on a LIVE Stripe key they are refused until this is 1. Set it
# only after trying a change in Stripe test mode.
# ADMIN_LIVE_PRICE_CHANGES=1
