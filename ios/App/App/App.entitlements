<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability: kitchen alerts through APNs.
	     "development" for debug builds; Xcode signs App Store and
	     TestFlight builds with the production environment. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Time Sensitive Notifications capability: a new order rings through
	     Focus and Scheduled Summary (interruption-level "time-sensitive",
	     src/lib/push/apns-core.ts). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
